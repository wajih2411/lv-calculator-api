@baseUrl = https://c97n2mb951.execute-api.us-east-1.amazonaws.com

### Valid request: expect 200
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "cameraCount": 10,
  "resolution": "1080p",
  "retentionDays": 30
}

### Invalid request: expect 400 (cameraCount must be at least 1)
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "cameraCount": 0,
  "resolution": "1080p",
  "retentionDays": 30
}
